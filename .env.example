# Local development variables. Copy to .env before running the app:
#   cp .env.example .env
# No secrets or external credentials are required.

# SQLite database file, relative to the project root (Prisma 7 + prisma.config.ts).
DATABASE_URL="file:./prisma/dev.db"

# Disable Next.js anonymous telemetry for reproducible benchmark runs.
NEXT_TELEMETRY_DISABLED=1
