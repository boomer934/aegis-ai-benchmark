generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Mission {
  id          String   @id
  profile     String
  paint       String
  lights      Boolean
  outcome     String
  durationMs  Int
  checkpoints Int
  collisions  Int
  score       Int
  energy      Float
  samples     Json
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([outcome, score, durationMs])
}
