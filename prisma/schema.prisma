generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model Mission {
  id         String   @id
  createdAt  DateTime @default(now())
  profile    String
  paint      String
  outcome    String
  durationMs Int
  gates      Int
  collisions Int
  score      Int
  @@index([createdAt])
  @@index([score])
}
