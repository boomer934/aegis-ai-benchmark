// AEGIS — Drone Test Facility data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One completed (successful or failed) flight-test mission reported by the client.
model MissionRecord {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  callsign     String
  outcome      String // "success" | "failed"
  engine       String // "ECO" | "SPORT" | "RACE"
  paint        String
  durationMs   Int
  score        Int
  checkpoints  Int
  collisions   Int
  maxSpeed     Float
  avgSpeed     Float
  energyUsed   Float
  /// JSON-encoded downsampled telemetry trace: [[tSeconds, speed, altitude, energy], ...]
  telemetry    String
  clientBuild  String

  @@index([outcome, score])
  @@index([createdAt])
}
